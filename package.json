{
	"name": "project-submission-backend",
	"version": "1.0.0",
	"private": false,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsup && tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"start": "node dist/server.js",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"check:fix": "biome check --write ."
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"bcryptjs": "^3.0.3",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^18.0.8",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.1",
		"http-status": "^2.1.0",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.6.5",
		"prisma": "^7.10.1",
		"tsup": "^8.5.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
